rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // 0. Global Safety Net
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Phase 3: Primitive Definitions (Helper Functions)
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Identity integrity check for document creation
    function isAuthBound(data) {
      return data.userId == request.auth.uid;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "purnundurayr@gmail.com" ||
         request.auth.token.email == "9999999999@lakshmi.club" ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Helper for string validation
    function isValidString(val, max) {
      return val is string && val.size() <= max;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Validation Blueprints (Anti-Update-Gap)
    // ===============================================================

    function isValidUser(data) {
      let requiredFields = ['id', 'phone', 'name', 'balance', 'status', 'role', 'createdAt', 'totalDeposit', 'referralCount', 'referralDepositCount', 'referralDepositAmount'];
      return data.keys().hasAll(requiredFields) &&
             isValidString(data.phone, 20) &&
             isValidString(data.name, 50) && data.name.size() > 0 &&
             data.balance is number &&
             data.totalDeposit is number &&
             data.referralCount is number &&
             data.referralDepositCount is number &&
             data.referralDepositAmount is number &&
             data.role in ['user', 'admin'] &&
             data.status in ['active', 'blocked'];
    }

    function isValidBet(data) {
      let requiredFields = ['userId', 'roundId', 'mode', 'amount', 'selection', 'status', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             data.userId == request.auth.uid &&
             isValidString(data.roundId, 50) &&
             data.mode in ['1min', '3min', '5min', '10min'] &&
             data.amount is number && data.amount > 0 &&
             (data.selection is string || data.selection is number) &&
             data.status in ['pending', 'win', 'loss'];
    }

    function isValidDeposit(data) {
      let requiredFields = ['userId', 'amount', 'utr', 'status', 'createdAt', 'orderNumber'];
      return data.keys().hasAll(requiredFields) &&
             (data.userId == request.auth.uid || request.auth.token.email == data.userId + "@lakshmi.club") &&
             data.amount is number && data.amount > 0 &&
             isValidString(data.utr, 50) &&
             data.status in ['pending', 'completed', 'failed'];
    }

    function isValidWithdrawal(data) {
      let requiredFields = ['userId', 'amount', 'status', 'createdAt', 'orderNumber', 'method'];
      return data.keys().hasAll(requiredFields) &&
             (data.userId == request.auth.uid || request.auth.token.email == data.userId + "@lakshmi.club") &&
             data.amount is number && data.amount > 0 &&
             data.status in ['pending', 'completed', 'failed'];
    }

    function isValidTransaction(data) {
      let requiredFields = ['userId', 'type', 'amount', 'status', 'createdAt', 'description'];
      return data.keys().hasAll(requiredFields) &&
             (data.userId == request.auth.uid || request.auth.token.email == data.userId + "@lakshmi.club" || isAdmin()) &&
             data.amount is number &&
             data.type in ['deposit', 'withdrawal', 'bet', 'win', 'gift', 'referral', 'refund'] &&
             data.status in ['pending', 'completed', 'failed'];
    }

    // ===============================================================
    // Resources
    // ===============================================================

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); // Only admins can list all users
      
      // Personalized query check for self-listing by phone (used in login/check)
      allow list: if isAuthenticated() && resource.data.phone + "@lakshmi.club" == request.auth.token.email;

      allow create: if isAuthenticated() && isValidUser(incoming()) && isOwner(userId);
      
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) && 
         incoming().role == existing().role && 
         incoming().status == existing().status &&
         (incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'totalDeposit', 'referralCount', 'name', 'phone']))) ||
        // Allow anyone to increment referralCount of another user by exactly 1 (used for referrals)
        (incoming().diff(existing()).affectedKeys().size() == 1 && 
         incoming().diff(existing()).affectedKeys().hasOnly(['referralCount']) &&
         incoming().referralCount == existing().referralCount + 1)
      );
    }

    match /bets/{betId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin() || resource.data.status == 'win');
      
      allow create: if isAuthenticated() && (isAdmin() || isValidBet(incoming()));
      
      allow update: if isAuthenticated() && (
        isAdmin() ||
        // User updating their own bet result (only allowed if status is terminal and matches calculation)
        (resource.data.userId == request.auth.uid && 
         existing().status == 'pending' && 
         incoming().status in ['win', 'loss'] &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'payout', 'result']))
      );
    }

    match /game_history/{roundId} {
      allow read: if true;
      allow create: if isAuthenticated() && (isAdmin() || isValidGameHistory(incoming()));
      allow update: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /deposits/{depositId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.phone + "@lakshmi.club" == request.auth.token.email || isAdmin());
      allow list: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.phone + "@lakshmi.club" == request.auth.token.email);
      allow create: if isAuthenticated() && (isAdmin() || isValidDeposit(incoming()));
      allow update: if isAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.phone + "@lakshmi.club" == request.auth.token.email || isAdmin());
      allow list: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.phone + "@lakshmi.club" == request.auth.token.email);
      allow create: if isAuthenticated() && (isAdmin() || isValidWithdrawal(incoming()));
      allow update: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.phone + "@lakshmi.club" == request.auth.token.email || isAdmin());
      allow list: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.phone + "@lakshmi.club" == request.auth.token.email);
      allow create: if isAuthenticated() && (isAdmin() || isValidTransaction(incoming()));
      allow update: if isAdmin();
    }

    match /giftcards/{cardId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /_test_connection_/{docId} {
      allow read: if true;
    }
  }
}
