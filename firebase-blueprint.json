{
  "entities": {
    "User": {
      "title": "User",
      "description": "Application user profile and balance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phone": { "type": "string" },
        "password": { "type": "string" },
        "name": { "type": "string" },
        "balance": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "blocked"] },
        "totalDeposit": { "type": "number" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "referredBy": { "type": "string" },
        "referralCount": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "phone", "name", "balance", "status", "role", "createdAt"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Home page slider banners",
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["url", "order", "createdAt"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Offers and events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "type": { "type": "string", "enum": ["banner", "offer"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "imageUrl", "type", "createdAt"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Global application settings and pop-up banner",
      "type": "object",
      "properties": {
        "popupBanner": { "type": "string" },
        "minDeposit": { "type": "number" },
        "minWithdrawal": { "type": "number" },
        "adminUpi": { "type": "string" },
        "whatsapp": { "type": "string" },
        "customerSupport": { "type": "string" }
      }
    },
    "Bet": {
      "title": "Bet",
      "description": "User game bets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "roundId": { "type": "string" },
        "mode": { "type": "string", "enum": ["1min", "3min", "5min", "10min"] },
        "amount": { "type": "number" },
        "selection": { "type": ["string", "number"] },
        "status": { "type": "string", "enum": ["pending", "win", "loss"] },
        "payout": { "type": "number" },
        "createdAt": { "type": "object" },
        "result": { "type": "object" }
      },
      "required": ["userId", "roundId", "mode", "amount", "selection", "status", "createdAt"]
    },
    "GameHistory": {
      "title": "GameHistory",
      "description": "Completed game rounds results",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "mode": { "type": "string" },
        "resultNumber": { "type": "number" },
        "resultColor": { "type": "array", "items": { "type": "string" } },
        "resultBigSmall": { "type": "string" },
        "startTime": { "type": "number" },
        "endTime": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "mode", "resultNumber", "resultColor", "resultBigSmall", "status"]
    },
    "GiftCard": {
      "title": "GiftCard",
      "description": "Redeemable gift codes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "amount": { "type": "number" },
        "minDeposit": { "type": "number" },
        "status": { "type": "string" },
        "claimedBy": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["code", "amount", "status"]
    },
    "Deposit": {
      "title": "Deposit",
      "description": "Deposit requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "phone": { "type": "string" },
        "amount": { "type": "number" },
        "utr": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "createdAt": { "type": "object" },
        "processedAt": { "type": "object" },
        "processedBy": { "type": "string" },
        "orderNumber": { "type": "string" }
      },
      "required": ["userId", "amount", "utr", "status", "createdAt", "orderNumber"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "description": "Withdrawal requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "timestamp": { "type": "number" },
        "method": { "type": "string" }
      }
    },
    "Prediction": {
      "title": "Prediction",
      "description": "Game outcome predictions for different modes",
      "type": "object",
      "properties": {
        "currentRoundId": { "type": "string" },
        "currentResult": { 
          "type": "object",
          "properties": {
            "number": { "type": "number" },
            "color": { "type": "array", "items": { "type": "string" } },
            "bigSmall": { "type": "string" }
          }
        },
        "nextRoundId": { "type": "string" },
        "nextResult": {
          "type": "object",
          "properties": {
            "number": { "type": "number" },
            "color": { "type": "array", "items": { "type": "string" } },
            "bigSmall": { "type": "string" }
          }
        }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/banners/{bannerId}": {
      "schema": "Banner",
      "description": "Home banners"
    },
    "/activities/{activityId}": {
      "schema": "Activity",
      "description": "Offers and events"
    },
    "/config/settings": {
      "schema": "AppConfig",
      "description": "Global app settings"
    },
    "/config/{predictionId}": {
      "schema": "Prediction",
      "description": "Game predictions"
    },
    "/bets/{betId}": {
      "schema": "Bet",
      "description": "Game bets"
    },
    "/game_history/{roundId}": {
      "schema": "GameHistory",
      "description": "Game history"
    },
    "/giftcards/{cardId}": {
      "schema": "GiftCard",
      "description": "Gift cards"
    },
    "/deposits/{depositId}": {
      "schema": "Deposit",
      "description": "Deposit requests"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": "Withdrawal",
      "description": "Withdrawal requests"
    }
  }
}
